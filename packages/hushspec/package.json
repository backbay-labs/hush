{
  "name": "@hushspec/core",
  "version": "1.0.0",
  "description": "Agentic compliance as code: portable policy spec for AI agent security controls",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run build && node bench/evaluate.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/backbay-labs/hush",
    "directory": "packages/hushspec"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "files": ["dist"],
  "keywords": ["ai", "security", "policy", "agent", "hushspec", "guardrails"]
}
